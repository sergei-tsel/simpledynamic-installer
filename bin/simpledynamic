#!/usr/bin/env php
<?php

use Simpledynamic\Installer\NewCommand;
use Symfony\Component\Console\Application;

if (file_exists(__DIR__ . '/../vendor/autoload.php')) {
    require_once __DIR__ . '/../vendor/autoload.php';
} elseif (file_exists(__DIR__ . '/../../../autoload.php')) {
    require_once __DIR__ . '/../../../autoload.php'; // Для глобальной установки
} else {
    echo "❌ Ошибка: не найден автозагрузчик Composer.\n";
    exit(1);
}

$command = new NewCommand();
$application = new Application('Simpledynamic Installer', '1.0');
$application->add($command);

$command->getDefinition();

$application->setDefaultCommand('new', true);
$application->run();
