{
    "name": "sergei-tsel/simpledynamic-installer",
    "description": "Simpledynamic framework installer",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "symfony/console": "^6.0",
        "symfony/process": "^6.0",
        "symfony/filesystem": "^6.0"
    },
    "autoload": {
        "psr-4": {
            "SimpleDynamic\\Installer\\": "src/"
        }
    },
    "bin": [
        "bin/simpledynamic"
    ],
    "config": {
        "allow-plugins": {
            "composer/installers": true
        }
    }
}
